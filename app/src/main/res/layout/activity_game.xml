<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/game_root"
    android:keepScreenOn="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/game_header"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/back_home"
            style="@style/Widget.Sudoku.IconButton"
            android:contentDescription="@string/back_home"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/game_difficulty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/homeMuted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/game_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:text="@string/timer_initial"
                android:textColor="?attr/homeForeground"
                android:textSize="16sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/game_theme"
            style="@style/Widget.Sudoku.IconButton"
            android:contentDescription="@string/choose_theme"
            android:src="@drawable/ic_palette" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/game_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/game_header">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="660dp">

            <TextView
                android:id="@+id/sample_puzzle_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/sample_puzzle"
                android:textColor="?attr/homeMuted"
                android:textSize="11sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/board_area"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="40dp"
                app:layout_constraintBottom_toTopOf="@id/number_pad"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/sample_puzzle_label">

                <sudoku.ui.game.board.SudokuBoardView
                    android:id="@+id/sudoku_board"
                    android:layout_width="300dp"
                    android:layout_height="300dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/game_completed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:text="@string/game_completed"
                android:textColor="?attr/homeForeground"
                android:textSize="18sp"
                android:visibility="gone"
                app:layout_constraintBottom_toTopOf="@id/number_pad"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <GridLayout
                android:id="@+id/number_pad"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="48dp"
                android:columnCount="5"
                android:layoutDirection="ltr"
                android:rowCount="2"
                app:layout_constraintBottom_toTopOf="@id/game_tools"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintWidth_max="360dp" />

            <LinearLayout
                android:id="@+id/game_tools"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintWidth_max="440dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/restart_game"
                    style="@style/Widget.Sudoku.ToolButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/new_game"
                    app:icon="@drawable/ic_restart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/game_settings"
                    style="@style/Widget.Sudoku.ToolButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/settings"
                    app:icon="@drawable/ic_settings" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/notes"
                    style="@style/Widget.Sudoku.ToolButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:contentDescription="@string/notes_disabled"
                    app:backgroundTint="@color/notes_background"
                    app:icon="@drawable/ic_notes" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/undo"
                    style="@style/Widget.Sudoku.ToolButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/undo"
                    app:icon="@drawable/ic_undo" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
