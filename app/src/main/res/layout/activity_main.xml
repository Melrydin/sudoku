<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/theme_selector"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="480dp">

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/select_theme"
            style="@style/Widget.Sudoku.IconButton"
            android:contentDescription="@string/choose_theme"
            android:src="@drawable/ic_palette" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/home_footer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/theme_selector">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="360dp"
            android:paddingHorizontal="32dp"
            android:paddingVertical="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.52"
                app:layout_constraintWidth_max="320dp">

                <ImageView
                    android:layout_width="168dp"
                    android:layout_height="168dp"
                    android:background="@drawable/background_sudoku_mark"
                    android:importantForAccessibility="no"
                    android:padding="32dp"
                    android:src="@drawable/ic_sudoku_mark" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/previous_difficulty"
                        style="@style/Widget.Sudoku.IconButton"
                        android:contentDescription="@string/previous_difficulty"
                        android:src="@drawable/ic_chevron_left" />

                    <TextView
                        android:id="@+id/difficulty_name"
                        style="@style/Widget.Sudoku.SelectorLabel"
                        android:text="@string/difficulty_easy" />

                    <ImageButton
                        android:id="@+id/next_difficulty"
                        style="@style/Widget.Sudoku.IconButton"
                        android:contentDescription="@string/next_difficulty"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/previous_level"
                        style="@style/Widget.Sudoku.IconButton"
                        android:contentDescription="@string/previous_level"
                        android:src="@drawable/ic_chevron_left" />

                    <TextView
                        android:id="@+id/level_name"
                        style="@style/Widget.Sudoku.SelectorLabel"
                        android:accessibilityLiveRegion="polite" />

                    <ImageButton
                        android:id="@+id/next_level"
                        style="@style/Widget.Sudoku.IconButton"
                        android:contentDescription="@string/next_level"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/new_game"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif"
                    android:insetTop="4dp"
                    android:insetBottom="4dp"
                    android:text="@string/new_game"
                    android:textAllCaps="false"
                    android:textColor="?attr/homeForeground"
                    android:textSize="17sp"
                    app:backgroundTint="@android:color/transparent"
                    app:cornerRadius="28dp"
                    app:strokeColor="?attr/homeOutline"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/continue_game"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:fontFamily="sans-serif"
                    android:text="@string/continue_game"
                    android:textColor="?attr/homeForeground"
                    android:textSize="17sp"
                    android:visibility="invisible" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/home_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="96dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/settings"
            style="@style/Widget.Sudoku.IconButton"
            android:contentDescription="@string/settings"
            android:src="@drawable/ic_settings" />

        <ImageButton
            android:id="@+id/best_times"
            style="@style/Widget.Sudoku.IconButton"
            android:layout_marginHorizontal="48dp"
            android:contentDescription="@string/best_times"
            android:src="@drawable/ic_best_times" />

        <ImageButton
            android:id="@+id/about"
            style="@style/Widget.Sudoku.IconButton"
            android:contentDescription="@string/about"
            android:src="@drawable/ic_info" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
