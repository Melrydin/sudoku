<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/times_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/times_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="480dp">

        <ImageButton
            android:id="@+id/times_back"
            style="@style/Widget.Sudoku.IconButton"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/times_theme"
            style="@style/Widget.Sudoku.IconButton"
            android:contentDescription="@string/choose_theme"
            android:src="@drawable/ic_palette" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/times_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="64dp"
        android:layout_marginBottom="16dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/times_header"
        app:layout_constraintWidth_max="440dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/best_times"
                android:textColor="?attr/homeForeground"
                android:textSize="26sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/times_previous"
                    style="@style/Widget.Sudoku.IconButton"
                    android:contentDescription="@string/previous_difficulty"
                    android:src="@drawable/ic_chevron_left" />

                <TextView
                    android:id="@+id/times_difficulty"
                    style="@style/Widget.Sudoku.SelectorLabel" />

                <ImageButton
                    android:id="@+id/times_next"
                    style="@style/Widget.Sudoku.IconButton"
                    android:contentDescription="@string/next_difficulty"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <TextView
                android:id="@+id/times_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:gravity="center"
                android:text="@string/no_best_times"
                android:textColor="?attr/homeMuted"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/times_entries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
