<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/victory_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:background="@drawable/background_sudoku_mark"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_sudoku_mark" />

        <TextView
            android:id="@+id/victory_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="@string/victory_title"
            android:textColor="?attr/homeForeground"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/victory_puzzle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="?attr/homeMuted"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:gravity="center"
            android:text="@string/victory_time_label"
            android:textColor="?attr/homeMuted"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/victory_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:textColor="?attr/homeForeground"
            android:textSize="40sp" />

        <TextView
            android:id="@+id/victory_assistance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="?attr/homeMuted"
            android:textSize="18sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/victory_best_times"
            style="@style/Widget.Sudoku.MenuButton"
            android:layout_width="match_parent"
            android:layout_marginTop="40dp"
            android:text="@string/best_times" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/victory_home"
            style="@style/Widget.Sudoku.MenuButton"
            android:layout_width="match_parent"
            android:layout_marginTop="12dp"
            android:text="@string/back_home" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
