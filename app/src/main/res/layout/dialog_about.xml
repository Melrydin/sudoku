<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/background_sudoku_mark"
        android:importantForAccessibility="no"
        android:padding="12dp"
        android:src="@drawable/ic_sudoku_mark" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/app_name"
        android:textColor="?attr/homeForeground"
        android:textSize="26sp" />

    <TextView
        android:id="@+id/about_version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textColor="?attr/homeMuted"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="20dp"
        android:gravity="center"
        android:text="@string/about_message"
        android:textColor="?attr/homeForeground"
        android:textSize="16sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/about_close"
        style="@style/Widget.Sudoku.MenuButton"
        android:text="@string/close" />
</LinearLayout>
