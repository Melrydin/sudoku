<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingVertical="36dp">

    <TextView
        android:id="@+id/setting_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="?attr/homeForeground"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/setting_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textColor="?attr/homeMuted"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/setting_toggle"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="16dp"
        android:checkable="true"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:padding="0dp"
        android:saveEnabled="false"
        android:textAllCaps="false"
        android:textColor="@color/setting_foreground"
        android:textSize="18sp"
        app:backgroundTint="@color/setting_background"
        app:cornerRadius="36dp"
        app:strokeColor="?attr/homeOutline"
        app:strokeWidth="1dp" />
</LinearLayout>
